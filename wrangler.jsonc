{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "storage-provider",
  // Pre-bundled by `deno task build:cf` (Deno resolves jsr/npm/workspace
  // specifiers wrangler/esbuild cannot). The bundle's default export is the
  // Remix fetch-router, which is a valid Workers module entry as-is.
  "main": "dist/worker.js",
  "compatibility_date": "2025-09-23",
  // `nodejs_compat` satisfies leftover `node:*` builtins; the populate flag
  // mirrors vars + secrets into `process.env` so `env.ts` reads config without
  // a per-request worker wrapper.
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env"
  ],

  // Static assets: bundled client JS + app/static, merged into dist/public by
  // the build. Served before the worker; unmatched paths fall through.
  "assets": {
    "directory": "./dist/public",
    "binding": "ASSETS"
  },

  "observability": {
    "enabled": true
  },

  // Non-secret defaults. Set the rest with `wrangler secret put <NAME>`:
  //   R2_ACCOUNT_ID, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY, R2_BUCKET,
  //   SYSTEM_ADMIN_USER_IDS, STORAGE_ORIGIN (this Worker's public origin).
  "vars": {
    "IDP_ORIGIN": "https://id.kbn.one"
  }
}
