{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "storage-provider",
  // Pre-bundled by `deno task build:cf` (Deno resolves jsr/npm/workspace
  // specifiers wrangler/esbuild cannot). Entry is app/server/worker.ts, which
  // receives the R2 binding + env and delegates to the Remix fetch-router.
  "main": "dist/worker.js",
  "compatibility_date": "2025-09-23",
  // Satisfies leftover node:* builtins pulled in by jose.
  "compatibility_flags": ["nodejs_compat"],

  // Custom domain. Requires the `kbn.one` zone to be active in this Cloudflare
  // account; wrangler then provisions the DNS record + certificate on deploy.
  // Remove this block to serve on *.workers.dev instead (and set STORAGE_ORIGIN
  // to that URL).
  "routes": [
    {
      "pattern": "storage.kbn.one",
      "custom_domain": true
    }
  ],

  // Static assets: bundled client JS + app/static, merged into dist/public by
  // the build. Served before the worker; unmatched paths fall through.
  "assets": {
    "directory": "./dist/public",
    "binding": "ASSETS"
  },

  // R2 bucket binding. Create the bucket first:
  //   wrangler r2 bucket create kbn-storage
  // then set bucket_name below. No access keys needed — the binding is
  // authenticated by the platform.
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "kbn-storage"
    }
  ],

  "observability": {
    "enabled": true
  },

  // Scheduled deletion of expired objects. The worker's `scheduled` handler
  // runs `pruneExpired`, deleting objects whose `expire-at` metadata has
  // passed (set per-upload via `?expireDays=N`; e.g. home portal's attached
  // images expire after 7 days). Runs daily; objects without an `expire-at`
  // (stamps) are never touched.
  "triggers": {
    "crons": ["17 3 * * *"]
  },

  // Non-secret config. None of these are sensitive (an IdP origin, this
  // Worker's own origin, and the admin user id allow-list), so they live here
  // rather than as `wrangler secret`s.
  "vars": {
    "IDP_ORIGIN": "https://id.kbn.one",
    "STORAGE_ORIGIN": "https://storage.kbn.one",
    "SYSTEM_ADMIN_USER_IDS": "7499d00d-fcff-4630-91a0-c034893c8d08"
  }
}
